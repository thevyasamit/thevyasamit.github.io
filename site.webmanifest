---
layout: null
sitemap: false
permalink: /site.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | strip_newlines | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "browser",
  "background_color": "#111315",
  "theme_color": "#111315",
  "icons": [
    { "src": "{{ '/images/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/images/personal_logo.png' | relative_url }}", "sizes": "512x512", "type": "image/png" }
  ]
}
